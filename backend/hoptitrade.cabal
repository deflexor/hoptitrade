cabal-version:      3.0
name:               hoptitrade
version:            0.1.0.0
synopsis:           Real-time Options Trading Bot & Dashboard
homepage:           https://github.com/hoptitrade/hoptitrade
license:            MIT
license-file:       LICENSE
author:             HoptiTrade Team
maintainer:         team@hoptitrade.io
category:           Finance
build-type:         Simple
extra-doc-files:    CHANGELOG.md

tested-with:
    GHC == 9.6.3

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wredundant-constraints
        -Wmissing-deriving-strategies
        -Widentities
        -Wpartial-fields
        -Wno-unused-packages
        -fhide-source-paths
        -fwrite-ide-info
        -hiedir=.hie

common extensions
    default-extensions:
        DataKinds
        DeriveAnyClass
        DeriveGeneric
        DerivingStrategies
        DerivingVia
        ExplicitForAll
        FlexibleContexts
        FlexibleInstances
        GADTs
        GeneralizedNewtypeDeriving
        LambdaCase
        MultiParamTypeClasses
        OverloadedStrings
        PolyKinds
        RecordWildCards
        ScopedTypeVariables
        StandaloneDeriving
        StandaloneKindSignatures
        TypeApplications
        TypeFamilies
        TypeOperators
        TypeSynonymInstances
        ViewPatterns

executable hoptitrade
    import:           warnings, extensions
    main-is:          Main.hs
    build-depends:
        base >=4.18 && <5,
        aeson >=2.1,
        aeson-pretty >=0.8,
        bytestring >=0.11,
        case-insensitive >=1.2,
        cryptonite >=0.30,
        http-api-data >=0.5,
        http-client >=0.7,
        http-client-tls >=0.3,
        http-types >=0.12,
        memory >=0.18,
        mtl >=2.3,
        polysemy >=1.9,
        polysemy-plugin >=0.4,
        scientific >=0.3,
        servant >=0.20,
        servant-server >=0.20,
        stm >=2.5,
        text >=2.0,
        time >=1.12,
        transformers >=0.6,
        unordered-containers >=0.2,
        uuid >=1.3,
        vector >=0.13,
        wai >=3.2,
        wai-cors >=0.2,
        warp >=3.3,
        websockets >=0.12,
        wuss >=2.0,
        req >=3.13,
        retry >=0.9,
        safe-exceptions >=0.1,
        base64-bytestring >=1.2,
        iso8601-time >=0.1
    hs-source-dirs:   src
    default-language: GHC2021
    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N
    other-modules:
        API.Auth
        API.Health
        API.Orders
        API.Positions
        API.Settings
        API.Strategies
        Domain.Greeks
        Domain.Option
        Domain.Order
        Domain.Position
        Domain.Settings
        Domain.Strategy
        Domain.Types
        Domain.User
        Effects.Auth
        Effects.Log
        Effects.OKX
        Effects.OrderBook
        Effects.Position
        Effects.Settings
        Effects.WebSocket
        Infrastructure.Config
        Infrastructure.OKX.Auth
        Infrastructure.OKX.Client
        Infrastructure.OKX.WebSocket
        Infrastructure.Persistence
        Infrastructure.WebSocket.Hub
        App.Application
        App.Server

test-suite hoptitrade-test
    import:           warnings, extensions
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >=4.18 && <5,
        hoptitrade,
        hspec >=2.11,
        hspec-discover >=2.11,
        QuickCheck >=2.14,
        quickcheck-instances >=0.3
    default-language: GHC2021
